[Unit]
Description=astrowidget allsky capture schedule (each morning, after astro dark ends)

[Timer]
# Machine-local morning time. Pick an hour after astro dark ENDS at the camera
# site year-round, and make sure the [allsky] window_hours in config.toml
# reaches back from this firing time to before dark BEGINS — e.g. an 08:00
# firing with window_hours = 14 covers 18:00 onward.
OnCalendar=*-*-* 08:00:00
# A machine asleep/off at the firing time runs the capture at next boot. The
# charts window still covers the night for a late-morning catch-up; a catch-up
# late enough that the window no longer reaches the start of astro dark keeps
# the reachable data, WARNS in the journal, and stores the truncated bounds so
# the row never claims coverage it doesn't have. Only a total miss fails.
Persistent=true

[Install]
WantedBy=timers.target
